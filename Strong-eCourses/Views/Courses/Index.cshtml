@model Strong_eCourses.Models.CourseViewModel
@{
    ViewData["Title"] = "Courses Page";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4">Kursevi</h1>
        <form method="get" class="filter-form">
            <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control" placeholder="Pretraži kurseve" />

            <select name="selectedCategory" class="form-select">
                <option value="">Sve kategorije</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(category == Model.SelectedCategory ? "selected" : null)">@category</option>
                }
            </select>

            <button type="submit" class="btn btn-dark w-100 rounded-0">Filtriraj</button>
        </form>
    </div>

    <div class="course-grid">
        @foreach (var course in Model.Courses)
        {
            
                <div class="course-card">
                    <a href="@course.Link" target="_blank" class="course-card-link">
                    <h5>@course.Name</h5>
                    <p>@course.School</p>
                    <p>@course.Difficulty</p>
                    <p><strong>Category:</strong> @course.Category</p>
                    </a>
                    @if(User.IsInRole("Admin"))
                    {
                        <div class="buttons">

                            <div class="formField submitBtn">
                                <a asp-controller="Courses" asp-action="Edit" asp-route-id="@course.Id">Izmeni</a>
                            </div>
                            <form asp-controller="Courses" asp-action="Delete" method="post" >
                                <input type="hidden" name="id" value="@course.Id" />
                                <div class="formField submitBtn"><input type="submit" class="accent" value="Obriši"></div>
                            </form>
                        </div>
                    }
                </div>

        }
    </div>

    <div class="pagination-controls text-center mt-4">
        @if (Model.CurrentPage > 1)
        {
            <a href="?searchQuery=@Model.SearchQuery&selectedCategory=@Model.SelectedCategory&page=@(Model.CurrentPage - 1)" class="btn btn-secondary">Prethodna</a>
        }
        <span class="mx-2">Strana @Model.CurrentPage od @Model.TotalPages</span>
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a href="?searchQuery=@Model.SearchQuery&selectedCategory=@Model.SelectedCategory&page=@(Model.CurrentPage + 1)" class="btn btn-secondary">Sledeća</a>
        }
    </div>
</div>
