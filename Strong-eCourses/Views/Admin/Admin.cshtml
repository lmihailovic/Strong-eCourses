@model List<Strong_eCourses.ApplicationUser>
@using Microsoft.AspNetCore.Authentication

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Dobro došli!</h1>
    <p>Admin stranica</p>
<h2>Svi korisnici</h2>

<table class="table">
    <thead>
        <tr>
            <th>Email</th>
            <th>Username</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>@user.UserName</td>
                <td>
                    <a href="">Rola</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
